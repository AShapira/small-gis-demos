@implements IAsyncDisposable
@inject HttpClient Http
@inject IJSRuntime JS

<main>
    <header>
        <div>
            <h1>Hello, OpenLayers!</h1>
            <p>GeoServer WMTS basemap with graphics from Blazor.</p>
        </div>
        <button @onclick="ResetView" disabled="@(_map is null)">Reset view</button>
    </header>
    <div class="legend" aria-label="Graphics legend">
        <span><i class="point"></i>Points</span>
        <span><i class="line"></i>Lines</span>
        <span><i class="polygon"></i>Polygons</span>
    </div>
    <p class="status" role="status" aria-live="polite">@_status</p>
    <div class="map" @ref="_mapElement" tabindex="0" aria-label="Interactive map"></div>
</main>

@code {
    private ElementReference _mapElement;
    private IJSObjectReference? _module;
    private IJSObjectReference? _map;
    private DotNetObjectReference<App>? _self;
    private string _status = "Loading map…";
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var options = await Http.GetFromJsonAsync<MapOptions>("map-config.json")
                ?? throw new InvalidOperationException("Map configuration is empty.");
            if (_disposed) return;
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/map.js");
            if (_disposed) { await _module.DisposeAsync(); return; }
            _self = DotNetObjectReference.Create(this);
            _map = await _module.InvokeAsync<IJSObjectReference>("createMap", _mapElement, options, SampleGraphics.Create(), _self);
            if (_disposed) { await _map.DisposeAsync(); return; }
        }
        catch (Exception ex)
        {
            _status = $"Map could not start: {ex.Message}";
        }
        if (!_disposed) StateHasChanged();
    }

    [JSInvokable]
    public Task SetStatus(string status)
    {
        if (_disposed) return Task.CompletedTask;
        _status = status;
        return InvokeAsync(StateHasChanged);
    }

    private async Task ResetView()
    {
        if (_map is not null) await _map.InvokeVoidAsync("resetView");
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        // DOM-dependent map cleanup is handled by map.js's MutationObserver.
        if (_map is not null) await _map.DisposeAsync();
        if (_module is not null) await _module.DisposeAsync();
        _self?.Dispose();
    }
}
