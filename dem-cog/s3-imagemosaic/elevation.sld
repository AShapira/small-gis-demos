<?xml version="1.0" encoding="UTF-8"?>
<StyledLayerDescriptor version="1.0.0" xmlns="http://www.opengis.net/sld"
  xmlns:ogc="http://www.opengis.net/ogc">
  <NamedLayer><Name>nasadem</Name><UserStyle><Title>NASADEM elevation</Title>
    <FeatureTypeStyle><Rule><RasterSymbolizer>
      <ColorMap>
        <ColorMapEntry color="#3355aa" quantity="-500"/>
        <ColorMapEntry color="#4d9270" quantity="0"/>
        <ColorMapEntry color="#b5b078" quantity="500"/>
        <ColorMapEntry color="#987653" quantity="1500"/>
        <ColorMapEntry color="#ffffff" quantity="4000"/>
      </ColorMap>
    </RasterSymbolizer></Rule></FeatureTypeStyle>
  </UserStyle></NamedLayer>
</StyledLayerDescriptor>
